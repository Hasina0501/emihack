generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
    id Int @id @default(autoincrement())
    name String 
    email String @unique
    password String  @unique
    role  role_admin @default(Admin)
    createdAt DateTime @default(now())
    updated_at DateTime @updatedAt
}


model Captcha{
  id Int  @id  @default(autoincrement())
  answers  String
  attemps  Int?  @default(0)
  fingerprint String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
enum role_admin{
    Admin
    admin
    Super_Admin
    super_admin
}